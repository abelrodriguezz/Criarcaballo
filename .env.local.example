# Copia este archivo como .env.local y completa con tus datos reales

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Índices/acciones (Twelve Data) → crea una key gratis en https://twelvedata.com
# Sin esta key, la sección de "Índices" en /mercado simplemente no se muestra
# (cripto vía Binance funciona sin ninguna key).
MARKET_API_KEY=tu-api-key-de-twelvedata

# Captcha del login (Cloudflare Turnstile) → crea un sitio gratis en
# https://dash.cloudflare.com/?to=/:account/turnstile
# El "Site Key" va aquí; el "Secret Key" se pega en Supabase → Authentication
# → Attack Protection → Enable Captcha protection (elige Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu-site-key-de-turnstile
