# Copia este archivo como .env.local y completa con tus datos reales

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Índices/acciones (Twelve Data) → crea una key gratis en https://twelvedata.com
# Sin esta key, la sección de "Índices" en /mercado simplemente no se muestra
# (cripto vía Binance funciona sin ninguna key).
MARKET_API_KEY=tu-api-key-de-twelvedata

# Secreto compartido entre el servidor de Next.js y las funciones de Postgres
# (ver supabase/migrations/019_integridad_dinero_y_senales.sql). OBLIGATORIO:
# sin él, "Reto del día" y el cierre automático de señales fallan a propósito.
# NO lleva prefijo NEXT_PUBLIC_ — nunca debe llegar al navegador: es justamente
# lo que impide que alguien llame los RPC de dinero directo con la anon key.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# y guarda EL MISMO valor en la base de datos:
#   update public.config_servidor set valor = 'TU_SECRETO'
#   where clave = 'trading_server_secret';
TRADING_SERVER_SECRET=genera-uno-con-el-comando-de-arriba

# Captcha del login (Cloudflare Turnstile) → crea un sitio gratis en
# https://dash.cloudflare.com/?to=/:account/turnstile
# El "Site Key" va aquí; el "Secret Key" se pega en Supabase → Authentication
# → Attack Protection → Enable Captcha protection (elige Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu-site-key-de-turnstile
